# ============================================================
# LearnSense production environment
# ============================================================

FLASK_ENV=production
FLASK_DEBUG=0

# PostgreSQL
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE

# Generate a long random value. NEVER commit the real value.
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Token lifetime
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# Dashboard
DASHBOARD_URL=https://your-domain.com/dashboard
DASHBOARD_ORIGIN=https://your-domain.com

# Rate limiter.
# For one local instance memory:// is okay.
# For multiple production instances use Redis, e.g.
# RATELIMIT_STORAGE_URI=redis://:PASSWORD@HOST:6379/0
RATELIMIT_STORAGE_URI=memory://

# Optional
MAX_CONTENT_LENGTH=2097152
LOG_LEVEL=INFO

# Set to 1 only when HTTPS is definitely enabled.
ENABLE_HSTS=1

# Server
PORT=5000
