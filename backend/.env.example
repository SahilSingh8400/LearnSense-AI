# ============================================================
# LearnSense AI - Environment Configuration Template
# ============================================================

# Environment Mode: 'development' or 'production'
FLASK_ENV=development
APP_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO

# Server Port
PORT=5000

# Security: JWT Secret Key (Generate a random 32+ char string in production)
JWT_SECRET_KEY=replace-with-a-random-32-character-secret-string-here

# Token Expiration (Minutes for Access Token, Days for Refresh Token)
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=30

# Database Configuration (SQLite for local dev, PostgreSQL for production)
# SQLite (default):
DATABASE_URL=sqlite:///learnsense.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/learnsense

# Web Dashboard URL and Origin
DASHBOARD_URL=http://localhost:5000
DASHBOARD_ORIGIN=http://localhost:5000

# Rate Limiter Storage ('memory://' for single instance, 'redis://...' for multi-instance)
RATELIMIT_STORAGE_URI=memory://

# ============================================================
# AI Diagnostic & Algorithmic Performance Audit
# ============================================================

# Option 1: Google Gemini API (Recommended - Free Tier Available)
# 1. Get a free API key at: https://aistudio.google.com/app/apikey
# 2. Paste your key below:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenRouter API (Alternative multi-model provider)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=liquid/lfm-3-1.7b:free
