{
  "manifest_version": 3,
  "name": "LearnSense AI",
  "version": "2.0.0",
  "description": "Tracks coding attempts locally and syncs accepted solutions to LearnSense AI.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://codechef.com/*",
    "https://www.codechef.com/*",
    "https://*.codechef.com/*",
    "https://hackerrank.com/*",
    "https://www.hackerrank.com/*",
    "https://*.hackerrank.com/*",
    "https://learnsense-ai.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LearnSense AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://codechef.com/*",
        "https://www.codechef.com/*",
        "https://*.codechef.com/*",
        "https://hackerrank.com/*",
        "https://www.hackerrank.com/*",
        "https://*.hackerrank.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-inject.js"],
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://codechef.com/*",
        "https://www.codechef.com/*",
        "https://*.codechef.com/*",
        "https://hackerrank.com/*",
        "https://www.hackerrank.com/*",
        "https://*.hackerrank.com/*"
      ]
    }
  ]
}
